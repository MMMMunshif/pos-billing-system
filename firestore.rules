rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Products, sales, stock, customers and payments are accessed through
    // the authenticated Express backend using Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
